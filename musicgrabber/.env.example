# Nach musicgrabber/.env kopieren und ausfüllen (.env ist gitignored).
# (KEIN API_KEY: siehe Kommentar in docker-compose.yml — ein Key sperrt die
# UI dauerhaft aus. Nur PUID/PGID/TZ werden gebraucht.)

# Container läuft als dieser User (musik-Pipeline muss die Staging-Dateien
# lesen/verschieben können) — Werte auf dem Pi:  id -u   /   id -g
PUID=1000
PGID=1000
TZ=Europe/Berlin
